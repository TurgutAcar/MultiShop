@model List<ResultCargoCustomerDto>
@{
    ViewData["Title"] = "UserAddressInfo";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<section class="content container-fluid">

    <div class="row">

        @foreach (var item in Model)

        {

            <div class="col-md-6">

                <div class="chart-box">


                   


                            <div class="mail-contnet">

                                <h4>@item.Title <span class="desig">- @item.Name @item.Surname</span></h4>

                                <p class="m-bot-2">@item.Address - @item.City - @item.District</p>

                                <h5>Telefon:@item.Phone </h5>

                                <h5>Email:@item.Email </h5>

                              

                            </div>



                </div>

            </div>

        }

    </div>

</section>
