@model UpdateAboutDto

@{
    ViewData["Title"] = "UpdateAbout";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}
<section class="content container-fluid">
    <div class="row">

        <div class="col-md-12">
            <div class="chart-box">
                <div class="bs-example" data-example-id="bordered-table">
                    <form method="post">
                        <input type="hidden" readonly class="form-control" asp-for="AboutId" />

                        <label>Açıklama</label>
                        <input type="text" class="form-control" asp-for="Description" />
                        <span asp-validation-for="Description" class="text-danger"></span>

                        <br />
                        <label>Adres</label>
                        <input type="text" class="form-control" asp-for="Address" />
                        <span asp-validation-for="Address" class="text-danger"></span>

                        <br />
                        <label>Email</label>
                        <input type="text" class="form-control" asp-for="Email" />
                        <span asp-validation-for="Email" class="text-danger"></span>

                        <br />
                        <label>Telefon</label>
                        <input type="text" class="form-control" asp-for="Phone" />
                        <span asp-validation-for="Phone" class="text-danger"></span>

                        <br />
                        <button class="btn btn-primary">Hakkımda Alanını Güncelle</button>
                    </form>
                </div>
            </div>
        </div>



    </div>
</section>


