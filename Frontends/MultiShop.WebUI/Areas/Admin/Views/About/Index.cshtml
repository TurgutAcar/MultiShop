
 @model BrandIndexViewModel
@{
    ViewData["Title"] = "Index";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<section class="content container-fluid">
    <div class="row">
        <div class="col-md-12">
            <div class="chart-box">
                <div class="bs-example">
                    <div id="about-grid-container">
                        @* Sayfa ilk açıldığında loading/skeleton görünsün diye *@
                        <partial name="_AboutContentPartial" model="Model" />
                    </div>

                 
                    <a href="/Admin/About/CreateAbout/"
                       class="btn btn-primary mt-3 @(Model.IsLoading ? "disabled" : "")">
                        Yeni Hakkımda Girişi
                    </a>


                </div>
            </div>
        </div>
    </div>
</section>
@section Scripts {
    <script>
        $(document).ready(function () {
            var url = '@Url.Action("GetAboutListPartial", "About", new { area = "Admin" })';
            // Sayfa açılır açılmaz isteği başlat
            $.get(url, function (data) {
                // Gelen hazır HTML paketini konteynerin içine bas
                $("#about-grid-container").html(data);

                // Yükleme bittiği için butonu aktif et (isteğe bağlı)
                $(".btn-primary").removeClass("disabled");
            });
        });
    </script>
}
