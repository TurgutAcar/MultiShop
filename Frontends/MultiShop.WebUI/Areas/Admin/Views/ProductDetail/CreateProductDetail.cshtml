@model CreateProductDetailDto


<section class="content container-fluid">
    <div class="row">

        <div class="col-md-12">
            <div class="chart-box">
                <div class="bs-example" data-example-id="bordered-table">
                    <form method="post" asp-action="CreateProductDetail" asp-controller="ProductDetail" asp-area="Admin">
                         <input type="hidden" readonly class="form-control" asp-for="ProductId" />
                        <label>Ürün Açıklaması</label>
                        <textarea rows="5" class="form-control" asp-for="ProductDescription"></textarea>
                        <span asp-validation-for="ProductDescription" class="text-danger"></span>

                        <br />
                        <label>Ürün Bilgisi</label>
                        <input type="text" class="form-control" asp-for="ProductInfo" />
                        <span asp-validation-for="ProductInfo" class="text-danger"></span>

                        <br />
                        <button class="btn btn-primary">Ürün detayı Girişi</button>
                    </form>
                </div>
            </div>
        </div>



    </div>
</section>

