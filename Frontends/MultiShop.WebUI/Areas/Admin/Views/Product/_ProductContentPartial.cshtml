@model ProductIndexViewModel

@if (Model.IsLoading)
{
    @await Component.InvokeAsync("_SkeletonTableComponentPartial")

}
else if (Model.Products == null || !Model.Products.Any())
{
    <div class="alert alert-secondary">Ürün bulunmuyor.</div>
}
else
{
    @* Senin asıl tablon *@
    <partial name="_ProductTable" model="Model.Products" />
}