@model UpdateBrandDto
@{
    ViewData["Title"] = "UpdateBrand";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}


<section class="content container-fluid">
    <div class="row">

        <div class="col-md-12">
            <div class="chart-box">
                <div class="bs-example" data-example-id="bordered-table">
                    <form method="post">
                        <input type="hidden" readonly class="form-control" asp-for="BrandId" />
                        <label>Marka Adı</label>
                        <input type="text" class="form-control" asp-for="BrandName" />
                        <span asp-validation-for="BrandName" class="text-danger"></span>

                        <br />
                        <label>Marka Görseli</label>
                        <input type="text" class="form-control" asp-for="ImageUrl" />
                        <span asp-validation-for="ImageUrl" class="text-danger"></span>

                        <br />
                        <button class="btn btn-primary">Markayı Güncelle</button>
                    </form>
                </div>
            </div>
        </div>



    </div>
</section>


