@model List<ResultBrandDto>

@{
    int count = 0;
}
<script>
    function confirmDelete(id, name) {
        Swal.fire({
            title: 'Emin misin?',
            text: `"${name}" markası silinecek`,
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#d33',
            cancelButtonColor: '#6c757d',
            confirmButtonText: 'Evet, Sil',
            cancelButtonText: 'Vazgeç'
        }).then((result) => {
            if (result.isConfirmed) {
                postDelete(id);
            }
        });
    }

    function postDelete(id) {
        fetch(`/Admin/Brand/DeleteBrand/${id}`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
            },
            body: `id=${id}`
        })
        .then(r => r.json())
    .then(res => {
        handleJsResponse(res, () => {
            setTimeout(() => location.reload(), 2000);
        });
        // if (res.IsSuccessful) {
        //     toastr[res.Source](res.Data);
        //     return;

        // }
        //   toastr[res.Source](res.errorMessages?.[0] ?? "Silme başarısız!");
        //   setTimeout(() => location.reload(), 4000);

        
    });
    }
</script>
<table class="table table-hover align-middle">
    <thead class="table-light">
        <tr>
            <th>#</th>
            <th>Marka</th>
            <th>Görsel</th>
            <th class="text-center">İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            count++;
            <tr>
                <td>@count</td>
                <td>@item.BrandName</td>
                <td>
                    <img src="@item.ImageUrl"
                         class="rounded"
                         style="width:40px;height:40px;object-fit:cover;" />
                </td>
                <td class="text-center">
                    <a href="/Admin/Brand/UpdateBrand/@item.BrandId"
                       class="btn btn-sm btn-success me-1">
                        <i class="fa fa-edit"></i>
                    </a>

                    <button class="btn btn-sm btn-danger"
                            onclick="confirmDelete('@item.BrandId','@item.BrandName')">
                        <i class="fa fa-trash"></i>
                    </button>
                </td>
            </tr>
        }
    </tbody>
</table>
