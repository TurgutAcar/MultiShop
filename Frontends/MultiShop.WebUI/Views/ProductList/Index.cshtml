
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/UILayout/_UILayout.cshtml";
}

<div class="container-fluid">
    <div class="row px-xl-5">
        <div class="col-lg-3 col-md-4">
            @await Component.InvokeAsync("_ProductListPriceFilterComponentPartial")

            @await Component.InvokeAsync("_ProductListColorFilterComponentPartial")

            @await Component.InvokeAsync("_ProductListSizeFilterComponentPartial")

        </div>
        <div class="col-lg-9 col-md-8">
            <div class="row pb-3">
                @await Component.InvokeAsync("_ProductListGetProductCountComponentPartial")
                @await Component.InvokeAsync("_ProductListComponentPartial",new{id=ViewBag.i})
                <div id="loading" class="text-center d-none">
                    <img src="/img/loading.gif" />
                </div>
                @await Component.InvokeAsync("_ProductListPaginationComponentPartial")

             
        
            </div>
        </div>
    </div>
</div>
<script>
    let page = 1;
    let loading = false;
    let finished = false;
    let categoryId = '@ViewBag.i';
    let lastPrice=null; 
    let lastId="";


      function updateCursor() {
        let cursor = $(".cursorData").last(); // ⚠️ SON eklenen
        if (cursor.length) {
            lastPrice = cursor.data("lastprice");
            lastId = cursor.data("lastid");

            console.log("Cursor updated:", lastPrice, lastId);
        }
    }


    window.addEventListener("scroll", function () {
            console.log("scroll fired");

        if (finished || loading) return;

        if ((window.innerHeight + window.scrollY) >= document.body.offsetHeight - 300) {
            loadMore();
        }
    });

    function loadMore() {
        loading = true;
        page++;

        $("#loading").removeClass("d-none");

        $.get(`/ProductList/LoadMore?id=${categoryId}&lastPrice=${lastPrice}&lastId=${lastId}`, function (data) {

            if (data.trim().length == 0) {
                finished = true;
            } else {
                $("#productContainer").append(data);
                updateCursor();
            }

            loading = false;
            $("#loading").addClass("d-none");
        });
    }
    setTimeout(updateCursor, 500);

</script>
