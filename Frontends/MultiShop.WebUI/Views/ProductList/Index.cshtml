
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/UILayout/_UILayout.cshtml";
}

<div class="container-fluid">
    <div class="row px-xl-5">
        <div class="col-lg-3 col-md-4">
            @await Component.InvokeAsync("_ProductListPriceFilterComponentPartial")

            @await Component.InvokeAsync("_ProductListColorFilterComponentPartial")

            @await Component.InvokeAsync("_ProductListSizeFilterComponentPartial")

        </div>
        <div class="col-lg-9 col-md-8">
            <div class="row pb-3">
                @await Component.InvokeAsync("_ProductListGetProductCountComponentPartial")

                <!-- ✅ ÜRÜNLER + SKELETON CONTAINER -->
                <div id="productContainer" class="row">
                    @* Sayfa ilk açıldığında skeleton *@
                    @await Component.InvokeAsync("_SkeletonCardComponentPartial")
                </div>

                <!-- LoadMore skeleton -->
                <div id="skeletonLoading" class="d-none w-100">
                    @await Component.InvokeAsync("_SkeletonCardComponentPartial")
                </div>

                <div id="loading" class="text-center d-none">
                    <img src="/img/loading.gif" />
                </div>

@*                 @await Component.InvokeAsync("_ProductListComponentPartial",new{id=ViewBag.i})
 *@              
@*                 @await Component.InvokeAsync("_ProductListPaginationComponentPartial")
 *@
             
        
            </div>
        </div>
    </div>
</div>
<script>
    let page = 1;
    let loading = false;
    let finished = false;
    let categoryId = '@ViewBag.i';
    let lastPrice=null; 
    let lastId="";


      function updateCursor() {
        let cursor = $(".cursorData").last(); // ⚠️ SON eklenen
        if (cursor.length) {
            lastPrice = cursor.data("lastprice");
            lastId = cursor.data("lastid");

            console.log("Cursor updated:", lastPrice, lastId);
        }
    }
            document.addEventListener("DOMContentLoaded", function () {

        fetch(`/ProductList/FirstLoad?id=${categoryId}`)
            .then(r => r.json()) //  TEXT DEĞİL JSON
            .then(res => {

                console.log(res);

                $("#productContainer").html(""); // skeleton temizle

                if (!res.items || res.items.length == 0) {
                    finished = true;
                    return;
                }

                res.items.forEach(p => {
                    $("#productContainer").append(renderProduct(p));
                });

                lastPrice = res.lastPrice;
                lastId = res.lastId;
            });
    });


  
    window.addEventListener("scroll", function () {
            console.log("scroll fired");

        if (finished || loading) return;

        if ((window.innerHeight + window.scrollY) >= document.body.offsetHeight - 300) {
            loadMore();
        }
    });
            function renderProduct(product) {
        return `
        <div class="col-lg-4 col-md-6 col-sm-6 pb-1 product-card">
            <div class="product-item bg-light mb-4">
                <div class="product-img position-relative overflow-hidden">
                    <img class="img-fluid w-100" src="${product.productImageUrl}">
                </div>
                <div class="text-center py-4">
                    <h6>${product.productName}</h6>
                    <h5>${product.productPrice} ₺</h5>
                </div>
            </div>
        </div>`;
    }


        function loadMore() {
        if (loading || finished) return;

        loading = true;
        $("#skeletonLoading").removeClass("d-none");

        fetch(`/ProductList/LoadMore?id=${categoryId}&lastPrice=${lastPrice}&lastId=${lastId}`)
            .then(r => r.json())
            .then(res => {

                if (!res.items || res.items.length == 0) {
                    finished = true;
                    return;
                }

                res.items.forEach(p => {
                    $("#productContainer").append(renderProduct(p));
                });

                lastPrice = res.lastPrice;
                lastId = res.lastId;
            })
            .finally(() => {
                $("#skeletonLoading").addClass("d-none");
                loading = false;
            });
    }

    setTimeout(updateCursor, 500);

</script>
