@model CreateRegisterDto
@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
	<meta charset="utf-8">
	<title>MultiShop Kayıt Formu</title>
	<!-- Mobile Specific Metas -->
	<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
	<!-- Font-->
	<link rel="stylesheet" type="text/css" href="~/colorlib-regform-30/css/opensans-font.css">
	<link rel="stylesheet" type="text/css" href="~/colorlib-regform-30/fonts/line-awesome/css/line-awesome.min.css">
	<!-- Jquery -->
	<!-- Main Style Css -->
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

	<link rel="stylesheet" href="~/colorlib-regform-30/css/style.css" />
</head>
<body class="form-v4">
	<div class="page-content">
		<div class="form-v4-content">
			<div class="form-left">
				<h2>MultiShop E-Ticaret</h2>
				<p class="text-1">MultiShop projemiz üzerinden işlemlerini gerçekleştirebilmek, indirimli ürünler ve fırsatlardan haberdar olmak adına 1 dakikada kayıt işlemini gerçekleştirin.</p>
				<p class="text-1">Eğer bir hesabınız varsa kayıt olmaya gerek duymadan aşağıdaki link üzerinden hemen giriş sayfasına gidebilirsiniz.</p>

				<div class="form-left-last">
					<a href="/Login/Index/" class="account">Giriş Yap</a>
				</div>
			</div>
			<form asp-action="Index" class="form-detail" asp-controller="Register" method="post">
				<h2>MultiShop Kayıt Formu</h2>
				<div asp-validation-summary="ModelOnly" class="text-danger"></div>

				<div class="form-group">
					<div class="form-row form-row-1">
						<label for="first_name">Adınız</label>
						<input type="text"  id="first_name" class="input-text" asp-for="Name">
						 <span asp-validation-for="Name" class="text-danger"></span>


					</div>
					<div class="form-row form-row-1">
						<label for="last_name">Soyadınız</label>
						<input type="text"  id="last_name" class="input-text" asp-for="Surname">
						<span asp-validation-for="Surname" class="text-danger"></span>


					</div>
				</div>
				<div class="form-row">
					<label for="your_email">Emai Adresi</label>
					<input type="text" id="your_email" asp-for="Email" class="input-text">
					<span asp-validation-for="Email" class="text-danger"></span>

				</div>
				<div class="form-row">
					<label for="your_username">Kullanıcı Adı</label>
					<input type="text" id="your_username" asp-for="UserName" class="input-text">
				        <span asp-validation-for="UserName" class="text-danger"></span>

				</div>
				<div class="form-group">
					<div class="form-row form-row-1 ">
						<label for="password">Şifre</label>
						<input type="password" id="password" class="input-text" asp-for="Password">
					            <span asp-validation-for="Password" class="text-danger"></span>

					</div>
					<div class="form-row form-row-1">
						<label for="comfirm-password">Şifre Tekrar</label>
						<input type="password" id="comfirm_password" asp-for="ConfirmPassword" class="input-text">
						<span asp-validation-for="ConfirmPassword" class="text-danger"></span>

					</div>
				</div>
				<div class="form-row-last">
					<button type="submit" class="register" style="height:30px">Kayıt Ol</button>
				</div>
			</form>
		</div>
	</div>
	<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
 
