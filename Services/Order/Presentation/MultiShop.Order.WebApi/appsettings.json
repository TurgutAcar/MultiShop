{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "IdentityServerUrl": "http://localhost:5001",
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "SqlServer": "Server=localhost,1440;Initial Catalog=MultiShopOrderDb;User=sa;Password=123456aA*;Encrypt=False;TrustServerCertificate=False;"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.Elasticsearch" ], //  Elasticsearch Sinks eklendi
    "MinimumLevel": {
      "Default": "Information", // Varsayılan log seviyesini Information yapın
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }, // Test için konsola yazmaya devam edebilirsiniz
      {
        "Name": "Elasticsearch", //  Elasticsearch ayarları
        "Args": {
          // Elasticsearch sunucunuzun URL'si
          "nodeUris": "http://localhost:9200",
          // İndeks adı (Loglarınızı tarih formatında tutmak idealdir)
          "indexFormat": "multishop-logs-{0:yyyy.MM.dd}",
          // Logların API'niz tarafından kendiliğinden oluşmasını sağlar
          "autoRegisterTemplate": true,
          // Logları JSON formatında gönderir
          "configureElasticsearchJsonFormatter": true,
          //  Bağlantı hatası olsa bile uygulamanın çökmemesi için
          "restrictedToMinimumLevel": "Information"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithProcessId",
      "WithThreadId"
    ]
  }
}
