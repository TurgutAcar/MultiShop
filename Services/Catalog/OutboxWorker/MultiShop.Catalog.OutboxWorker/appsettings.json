{
  "DatabaseSettings": {

    "OutboxMessageCollectionName": "OutboxMessages",


    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "MultiShopCatalogDb"
  },
  "Outbox": {
    "BatchSize": 20,
    "PollIntervalSeconds": 5,
    "LockDurationSeconds": 30
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information"
    }
  },
  "RabbitMQ": {
    "Host": "localhost",
    "Port": "5673",
    "Username": "guest",
    "Password": "guest"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.Elasticsearch" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "Elasticsearch",
        "Args": {

          "nodeUris": "http://localhost:9200",
          "indexFormat": "multishop-logs-{0:yyyy.MM.dd}",
          "autoRegisterTemplate": true,
          "configureElasticsearchJsonFormatter": true,
          "restrictedToMinimumLevel": "Information"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithProcessId",
      "WithThreadId"
    ]
  },

  "AllowedHosts": "*"
}
